VITE_APP_NAME="Welcome to my place"
VITE_APP_DESCRIPTION="Foster living together based on welcome, trust and mutual aid"
VITE_APP_LANG=en

VITE_BACKEND_URL=http://localhost:3002/
VITE_BACKEND_CLIENT_ID=${VITE_BACKEND_URL}app

VITE_SHAPE_REPOSITORY_URL=https://shapes.activitypods.org/

# If this is defined, the user will not be able to choose a pod provider
# This is useful to test a pod provider in a local dev environment
VITE_DEFAULT_POD_PROVIDER=http://localhost:3000

# If you want to see and manage addresses, you need to provide a MapBox access token.
# Otherwise the address autocomplete will be hidden.
# See https://docs.mapbox.com/help/getting-started/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=

# Port under which the application will be launched
VITE_PORT=4002
